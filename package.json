{
  "name": "digbot-nest",
  "version": "2.27.8",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "migration:create": "mikro-orm migration:create",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "mikro-orm migration:down",
    "migration:list": "mikro-orm migration:list",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "mikro-orm migration:up && node dist/src/main",
    "test": "jest --coverage",
    "test:wsl": "jest --coverage --maxWorkers=4",
    "test:ci": "jest --ci --coverage",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand"
  },
  "packageManager": "pnpm@11.15.1",
  "mikro-orm": {
    "preferTs": false
  },
  "engines": {
    "npm": ">=10.9.2",
    "pnpm": ">=10.25.0",
    "node": ">=24.12.0 <25.0.0"
  },
  "dependencies": {
    "@discord-nestjs/common": "^5.2.12",
    "@discord-nestjs/core": "^5.3.14",
    "@mikro-orm/core": "7.1.6",
    "@mikro-orm/decorators": "7.1.6",
    "@mikro-orm/mariadb": "7.1.6",
    "@mikro-orm/migrations": "7.1.6",
    "@mikro-orm/nestjs": "^7.0.0",
    "@mikro-orm/seeder": "7.1.6",
    "@mikro-orm/sql-highlighter": "^1.0.1",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/schedule": "^6.0.0",
    "@sentry/node": "^10.0.0",
    "@sentry/profiling-node": "^10.0.0",
    "axios": "^1.7.2",
    "discord.js": "^14.18.0",
    "dotenv": "^17.0.0",
    "lodash": "^4.17.21",
    "ps2census": "^4.6.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mikro-orm/cli": "7.1.6",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "^11.0.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/jest": "^30.0.0",
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "10.7.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.2",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3"
  }
}
